# Copy to `.env` for local use. `.env` is gitignored — never commit real values.

# Port the server listens on (0.0.0.0).
PORT=3000

# development | production
NODE_ENV=development

# Where db.json, uploads/ and the dev-only JWT secret are stored.
# Relative paths resolve against the project root. In production point this at a
# PERSISTENT volume, otherwise data is lost on every redeploy.
DATA_DIR=./server/data

# REQUIRED in production (>= 32 chars). In development one is generated into DATA_DIR/.jwt-secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public https URL of this deployment (used for the M91 callback URL later).
PUBLIC_BASE_URL=
